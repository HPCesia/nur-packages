+// normalizeEffortLevels rewrites the flat effort levels collected from
+// --reasoning-levels into the {value, display} objects the config schema
+// expects. Levels are deduplicated in declaration order, the configured
+// default effort is folded in so the model can actually select it, and
+// thinking is enabled unless the user set it explicitly.
+func normalizeEffortLevels(model map[string]any) {
+	reasoning, ok := model["reasoning"].(map[string]any)
+	if !ok {
+		return
+	}
+
+	declared, _ := reasoning["effort_levels"].([]any)
+	values := make([]string, 0, len(declared)+1)
+	for _, level := range declared {
+		value, ok := level.(string)
+		if !ok || value == "" || slices.Contains(values, value) {
+			continue
+		}
+		values = append(values, value)
+	}
+
+	if effort, ok := reasoning["default_effort_level"].(string); ok && effort != "" && !slices.Contains(values, effort) {
+		values = append(values, effort)
+	}
+
+	if len(values) == 0 {
+		delete(reasoning, "effort_levels")
+		return
+	}
+
+	levels := make([]any, 0, len(values))
+	for _, level := range catwalk.NewEffortLevels(values...) {
+		levels = append(levels, map[string]any{"value": level.Value, "display": level.Display})
+	}
+	reasoning["effort_levels"] = levels
+
+	if _, ok := reasoning["thinking"]; !ok {
+		reasoning["thinking"] = string(catwalk.ThinkingToggleable)
+	}
+}
