+// mergeCatalogModel merges a user model override on top of a base catalog
+// model. Fields explicitly set on the override replace the base values;
+// unset fields inherit from the catalog entry.
+func mergeCatalogModel(base, override catwalk.Model) catwalk.Model {
+	merged := base
+
+	if override.Type != "" {
+		merged.Type = override.Type
+	}
+	if override.Name != "" {
+		merged.Name = override.Name
+	}
+	if override.ContextWindow > 0 {
+		merged.ContextWindow = override.ContextWindow
+	}
+	if override.DefaultMaxTokens > 0 {
+		merged.DefaultMaxTokens = override.DefaultMaxTokens
+	}
+	if override.MaxAttachments > 0 {
+		merged.MaxAttachments = override.MaxAttachments
+	}
+
+	merged.Pricing = mergePricing(base.Pricing, override.Pricing)
+	merged.Reasoning = mergeReasoning(base.Reasoning, override.Reasoning)
+
+	// Capabilities are booleans that are always serialized, so a false
+	// override is indistinguishable from an unset one. Union the flags
+	// instead of letting an unset field disable a catalog capability.
+	merged.Capabilities = catwalk.Capabilities{
+		Vision: base.Capabilities.Vision || override.Capabilities.Vision,
+		Audio:  base.Capabilities.Audio || override.Capabilities.Audio,
+	}
+
+	merged.Options = mergeModelOptions(base.Options, override.Options)
+
+	return merged
+}
+
+func mergePricing(base, override catwalk.Pricing) catwalk.Pricing {
+	merged := base
+	if override.Input > 0 {
+		merged.Input = override.Input
+	}
+	if override.Output > 0 {
+		merged.Output = override.Output
+	}
+	if override.CacheCreate > 0 {
+		merged.CacheCreate = override.CacheCreate
+	}
+	if override.CacheHit > 0 {
+		merged.CacheHit = override.CacheHit
+	}
+	return merged
+}
+
+// mergeReasoning keeps the catalog effort levels and unions any levels the
+// override declares, so a model can add levels the catalog does not know
+// about without losing the ones it does.
+func mergeReasoning(base, override catwalk.Reasoning) catwalk.Reasoning {
+	merged := base
+	if override.Thinking != "" {
+		merged.Thinking = override.Thinking
+	}
+
+	switch {
+	case len(override.EffortLevels) > 0:
+		seen := make(map[string]bool, len(base.EffortLevels)+len(override.EffortLevels))
+		levels := make([]catwalk.EffortLevel, 0, len(base.EffortLevels)+len(override.EffortLevels))
+		for _, level := range slices.Concat(base.EffortLevels, override.EffortLevels) {
+			if seen[level.Value] {
+				continue
+			}
+			seen[level.Value] = true
+			levels = append(levels, level)
+		}
+		merged.EffortLevels = levels
+	case len(base.EffortLevels) > 0:
+		merged.EffortLevels = slices.Clone(base.EffortLevels)
+	}
+
+	if override.DefaultEffortLevel != "" {
+		merged.DefaultEffortLevel = override.DefaultEffortLevel
+		// The configured default must be selectable, otherwise
+		// ValidateReasoningEffort rejects it later.
+		if len(merged.EffortLevels) > 0 && !slices.ContainsFunc(merged.EffortLevels, func(level catwalk.EffortLevel) bool {
+			return level.Value == override.DefaultEffortLevel
+		}) {
+			merged.EffortLevels = append(merged.EffortLevels, catwalk.NewEffortLevels(override.DefaultEffortLevel)...)
+		}
+	}
+
+	// An override that asks for effort levels implicitly enables
+	// reasoning, even when it does not restate the thinking mode.
+	if merged.Thinking == "" && len(merged.EffortLevels) > 0 {
+		merged.Thinking = catwalk.ThinkingToggleable
+	}
+
+	return merged
+}
+
+func mergeModelOptions(base, override catwalk.ModelOptions) catwalk.ModelOptions {
+	merged := base
+	if override.Temperature != nil {
+		merged.Temperature = override.Temperature
+	}
+	if override.TopP != nil {
+		merged.TopP = override.TopP
+	}
+	if override.TopK != nil {
+		merged.TopK = override.TopK
+	}
+	if override.FrequencyPenalty != nil {
+		merged.FrequencyPenalty = override.FrequencyPenalty
+	}
+	if override.PresencePenalty != nil {
+		merged.PresencePenalty = override.PresencePenalty
+	}
+	if len(override.ProviderOptions) > 0 {
+		opts := make(map[string]any, len(base.ProviderOptions)+len(override.ProviderOptions))
+		maps.Copy(opts, base.ProviderOptions)
+		maps.Copy(opts, override.ProviderOptions)
+		merged.ProviderOptions = opts
+	}
+	return merged
+}
