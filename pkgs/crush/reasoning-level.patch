+// effortLevels renders declared levels the way the config schema stores
+// them, so tests can assert on the full {value, display} pairs.
+func effortLevels(values ...string) []any {
+	levels := make([]any, 0, len(values))
+	for _, value := range values {
+		display := strings.ToUpper(value[:1]) + value[1:]
+		if value == "xhigh" {
+			display = "X-High"
+		}
+		levels = append(levels, map[string]any{"value": value, "display": display})
+	}
+	return levels
+}
