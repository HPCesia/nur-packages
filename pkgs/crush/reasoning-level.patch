+// modelReasoning returns the reasoning object of the single model a script
+// registered on the given provider.
+func modelReasoning(t *testing.T, result map[string]any, provider string) map[string]any {
+	t.Helper()
+	models := result["providers"].(map[string]any)[provider].(map[string]any)["models"].([]any)
